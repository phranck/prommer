{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ bytes. The hex column is what goes into the EEPROM, mirrored for the audio chip. The text column is the same bytes as the chip will read them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Bytes. Die Hexspalte ist das, was in den Speicher geht, für den Audiochip gespiegelt. Die Textspalte zeigt dieselben Bytes so, wie der Chip sie liest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bytes. The hex column is what goes into the EEPROM, mirrored for the audio chip. The text column is the same bytes as the chip will read them."
          }
        }
      }
    },
    "%@ carries a character the chip cannot transmit. Use plain ASCII." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ enthält ein Zeichen, das der Chip nicht übertragen kann. Nimm reines ASCII."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ carries a character the chip cannot transmit. Use plain ASCII."
          }
        }
      }
    },
    "%@ is %lld characters long, and the field holds %lld." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist %lld Zeichen lang, und das Feld fasst %lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is %lld characters long, and the field holds %lld."
          }
        }
      }
    },
