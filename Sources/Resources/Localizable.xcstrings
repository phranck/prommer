    },
    "The transfer did not finish. The adapter was reset, so try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Übertragung ist nicht fertig geworden. Der Adapter wurde zurückgesetzt, versuch es nochmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The transfer did not finish. The adapter was reset, so try again."
          }
        }
      }
    },
    "The whole chip. The first %@ bytes are what gets written, and the rest is what the board already carries. The hex column is what sits in the EEPROM, mirrored for the audio chip up to the serial number; the text column is the same bytes as they are meant to be read." : {
      "comment" : "A description of the EEPROM, showing the bytes that are written and the ones that are already there.",
      "isCommentAutoGenerated" : true
    },
    "This has to match how the board is wired, so it is fixed. The audio chip misbehaves when the descriptor claims something the board does not do." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das muss zur Verdrahtung des Boards passen und steht deshalb fest. Der Audiochip verhält sich falsch, wenn der Deskriptor etwas behauptet, was das Board nicht tut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This has to match how the board is wired, so it is fixed. The audio chip misbehaves when the descriptor claims something the board does not do."
          }
        }
      }
    },
    "Up to %lld ASCII characters." : {
      "extractionState" : "manual",
      "localizations" : {
